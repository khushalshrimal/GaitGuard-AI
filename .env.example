# GaitGuard AI — Environment Variable Configuration Template (.env.example)

# Application Environment
GAITGUARD_ENV=production
GAITGUARD_DEBUG=False

# API Server Settings
PORT=8000
HOST=0.0.0.0

# Security & Upload Limits
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_VIDEO_DURATION_SEC=30.0
MAX_DECODED_FRAMES=900
REQUEST_TIMEOUT_SEC=60
MAX_CONCURRENT_INFERENCE=5

# CORS Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8000
